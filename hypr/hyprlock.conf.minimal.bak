# ==========================================================
#  Hyprlock — Catppuccin Mocha, minimal
#  Quiet typography, one accent, nothing else.
# ==========================================================
#
#  text        #cdd6f4   subtext0  #a6adc8
#  subtext1    #bac2de   overlay0  #6c7086
#  mauve       #cba6f7   crust     #11111b
#
#  Fonts: JetBrainsMono Nerd Font (all weights installed)
# ==========================================================


# ==========================================================
# BACKGROUND — blurred screenshot, gently dimmed
# ==========================================================

background {
    monitor =
    path = screenshot

    blur_passes = 2
    blur_size = 5
    noise = 0.011

    contrast = 1.0
    brightness = 0.58
}


# ==========================================================
# GENERAL
# ==========================================================

general {
    text_trim = true
    hide_cursor = true
    ignore_empty_input = false
    immediate_render = false
    fail_timeout = 2000
}


# ==========================================================
# ANIMATIONS — soft fade only
# ==========================================================

bezier = quiet, 0.23, 1, 0.32, 1

animation = fadeIn,  1, 2, quiet
animation = fadeOut, 1, 2, quiet

animation = inputFieldColors, 1, 1, quiet
animation = inputFieldFade,   1, 1, quiet
animation = inputFieldWidth,  1, 1, quiet
animation = inputFieldDots,   1, 1, quiet


# ==========================================================
# CLOCK — the only statement
# ==========================================================

label {
    monitor =
    text = cmd[update:1000] echo "$(date '+%H:%M')"

    color = rgba(205, 214, 244, 0.98)
    font_size = 128
    font_family = JetBrainsMono NF ExtraLight

    shadow_passes = 2
    shadow_size = 6
    shadow_color = rgba(17, 17, 27, 0.45)

    position = 0, 300
    halign = center
    valign = center
}


# ==========================================================
# DATE
# ==========================================================

label {
    monitor =
    text = cmd[update:60000] echo "$(date '+%A, %d %B')"

    color = rgba(166, 173, 200, 0.90)
    font_size = 20
    font_family = JetBrainsMono NF

    position = 0, -52
    halign = center
    valign = center
}


# ==========================================================
# DIVIDER — thin mauve thread
# ==========================================================

shape {
    monitor =
    size = 220, 1
    position = 0, -27
    halign = center
    valign = center

    color = rgba(0, 0, 0, 0)
    rounding = 1

    border_size = 1
    border_color = rgba(203, 166, 247, 0.65)
}


# ==========================================================
# PASSWORD — transparent pill, accent outline
# ==========================================================

input-field {
    monitor =

    size = 300, 52
    outline_thickness = 2

    outer_color = rgba(203, 166, 247, 0.75)
    inner_color = rgba(17, 17, 27, 0.45)

    font_color = rgba(205, 214, 244, 0.95)
    font_family = JetBrainsMono NF
    placeholder_text = <span foreground="#6c7086"><i>Password</i></span>

    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    dots_rounding = -1

    check_color = rgba(166, 227, 161, 0.90)
    fail_color  = rgba(243, 139, 168, 0.90)
    capslock_color = rgba(249, 226, 175, 1)

    fade_on_empty = true
    fade_timeout = 2000

    rounding = 26
    swap_font_color = true

    position = 0, 22
    halign = center
    valign = center
}


# ==========================================================
# KEYBOARD LAYOUT
# ==========================================================

label {
    monitor =
    text = $LAYOUT[EN,RU]

    color = rgba(108, 112, 134, 0.80)
    font_size = 13
    font_family = JetBrainsMono NF

    position = -15, 15
    halign = right
    valign = down
}
