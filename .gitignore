# --- Секреты и ключи ---
*.key
*.pem
*.pub
*secret*
*token*
*credential*
*password*
account.json

# --- Истории команд и логи (очень важно) ---
# Истории часто содержат введенные вами пароли в открытом виде
*history*
*.log
fish_history
bash_history

# --- Кэш и временные файлы окружения ---
# Защита от кэша шрифтов, превью картинок и временных файлов
.cache/
cache/
*.tmp
*.bak
*~

# --- Конфиги специфичных утилит, где часто бывают токены ---
# Если используете GitHub CLI, curl или специфичные менеджеры сессий
.config/gh/config.yml
.config/wakatime/wakatime.cfg

# --- Специфичные файлы систем сборки / Python ---
# На случай, если в дотфайлах лежат ваши кастомные скрипты автоматизации
__pycache__/
*.pyc
.venv/
venv/
